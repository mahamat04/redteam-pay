{
  "name": "redteam-pay",
  "version": "0.4.0",
  "description": "Payment webhook security lab and installable IDE agent using MCP and Agent Skills.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "redteam-pay": "./server.js",
    "redteam-pay-mcp": "./mcp-server.js"
  },
  "files": [
    "server.js",
    "mcp-server.js",
    "api/",
    "lib/",
    "public/",
    ".agents/skills/redteam-pay/",
    "scripts/",
    "vercel.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mcp": "node mcp-server.js",
    "setup:ide": "node scripts/install-ide.mjs",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "paypal",
    "fintech",
    "adversarial",
    "red-team",
    "payments",
    "webhooks",
    "security",
    "simulator"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^6.49.0",
    "zod": "^4.6.7"
  }
}
